      "title": "清洁洗护",
      "count": "8 种",
      "intro": "从手工皂、牙膏洗发沐浴到家居清洁剂，材料几乎家家都有，比市售便宜一大半，还能避开荧光剂、香精和多余添加。",
      "items": [
        {
          "id": "clean-1",
          "num": 1,
          "title": "皂基免制手工皂",
          "icon": "🧼",
          "difficulty": "简单",
          "duration": "快速",
          "time": "约 30 分钟 + 2 小时凝固",
          "yield": "约 4 块 60g 皂",
          "tags": ["新手友好", "送人", "零碱操作"],
          "materials": [
            { "name": "透明/白色皂基", "amount": "250g", "ratio": "主料", "note": "搜索「MP 皂基」即可买到" },
            { "name": "精油", "amount": "10～20 滴", "ratio": "约 1%", "note": "香型自定，孕妇/儿童选温和款" },
            { "name": "干花/食用色素", "amount": "少许", "ratio": "可选", "note": "装饰用" }
          ],
          "steps": [
            "皂基切小块，放入耐热玻璃碗，隔水加热并不停搅拌至完全熔化（约 60℃）。",
            "离火稍降温，滴入精油与色素搅匀，倒入硅胶模具。",
            "室温静置 1～2 小时凝固，脱模即可使用。"
          ],
          "note": "隔水加热、不要直接明火，温度勿超 70℃，否则皂面易起泡、变色。",
          "save": "自制单块约 3 元，市售手工皂约 15～40 元/块，自用送人皆宜。"
        },
        {
          "id": "clean-2",
          "num": 2,
          "title": "小苏打去污膏",
          "icon": "✨",
          "difficulty": "简单",
          "duration": "快速",
          "time": "即做即用，约 2 分钟",
          "yield": "1 份糊状膏",
          "tags": ["厨房", "去油", "零成本"],
          "materials": [
            { "name": "小苏打", "amount": "3 份", "ratio": "75%", "note": "食用级即可" },
            { "name": "清水", "amount": "1 份", "ratio": "25%", "note": "调成牙膏状糊" }
          ],
          "steps": [
            "小苏打与清水按 3:1 混合，搅成可涂抹的糊状。",
            "抹在锅底油垢、灶台、水槽，静置 10 分钟后用湿海绵擦净。",
            "顽固处可撒少量盐一起擦，再用清水冲净。"
          ],
          "note": "小苏打呈弱碱性，擦洗后记得用清水冲净；不要用于大理石、铝制品等怕碱表面。",
          "save": "替代市售去污膏，厨房一大罐小苏打可用数月。"
        },
        {
          "id": "clean-3",
          "num": 3,
          "title": "柑橘多功能清洁喷雾",
          "icon": "🍊",
          "difficulty": "简单",
          "duration": "需等待",
          "time": "浸泡 2 周后使用",
          "yield": "约 500ml",
          "tags": ["去味", "台面", "除油"],
          "materials": [
            { "name": "白醋", "amount": "250ml", "ratio": "50%", "note": "食用白醋即可" },
            { "name": "清水", "amount": "250ml", "ratio": "50%", "note": "凉开水为佳" },
            { "name": "柑橘皮", "amount": "2～3 个", "ratio": "增香", "note": "橙皮/柠檬皮洗净" }
          ],
          "steps": [
            "柑橘皮撕小块塞入玻璃罐，倒入等量白醋与水，盖紧。",
            "避光常温浸泡 2 周，期间偶尔摇晃。",
            "滤出液体装入喷瓶，用于厨房台面、去味、轻度去油。"
          ],
          "note": "醋有微弱酸性，避开大理石、天然石材台面；喷后可用湿布再擦一遍。",
          "save": "替代含表面活性剂的厨房清洁剂，成本几乎为零。"
        },
        {
          "id": "clean-4",
          "num": 4,
          "title": "无磷洗衣液",
          "icon": "🧴",
          "difficulty": "中等",
          "duration": "数小时",
          "time": "约 30 分钟 + 静置数小时",
          "yield": "约 2L 浓缩液",
          "tags": ["洗衣", "低敏", "大桶装"],
          "materials": [
            { "name": "肥皂（无香精皂）", "amount": "100g", "ratio": "主表活", "note": "刨成细丝" },
            { "name": "硼砂", "amount": "100g", "ratio": "助洗", "note": "可选购自药店/日杂" },
            { "name": "小苏打", "amount": "100g", "ratio": "软化水", "note": "食用级" },
            { "name": "热水", "amount": "约 2L", "ratio": "溶剂", "note": "分次加入" }
          ],
          "steps": [
            "肥皂丝倒入锅中，加少量热水小火搅拌至完全溶解。",
            "边搅边加入硼砂、小苏打，再分批倒入热水至约 2L，搅匀。",
            "关火静置数小时至冷却增稠，装入大桶，用前摇匀。"
          ],
          "note": "静置后可能分层或呈果冻状，属正常，摇匀即用；硼砂对儿童/宠物应妥善收纳。",
          "save": "一桶 2L 成本约 5～8 元，够洗几十次，且无荧光剂、香精更少。"
        },
        {
          "id": "clean-5",
          "num": 5,
          "title": "冷制橄榄油皂（进阶）",
          "icon": "🫒",
          "difficulty": "进阶",
          "duration": "需等待",
          "time": "操作约 1 小时，成熟 4～6 周",
          "yield": "约 10 块 50g 皂",
          "tags": ["纯植物油", "需碱", "传统手作"],
          "materials": [
            { "name": "橄榄油", "amount": "500g", "ratio": "100%", "note": "特级初榨/普通皆可" },
            { "name": "氢氧化钠（NaOH）", "amount": "67g", "ratio": "SAP 0.134", "note": "皂化值=油重×0.134" },
            { "name": "蒸馏水", "amount": "110g", "ratio": "约 NaOH 1.65 倍", "note": "不可用自来水" }
          ],
          "steps": [
            "戴橡胶手套、护目镜、口罩，在通风处铺报纸操作，量杯用耐碱容器。",
            "蒸馏水称入容器，把 NaOH 缓慢倒入水中（绝不可反着倒），搅拌至全部溶解，会放热，静置降温。",
            "橄榄油隔水加热至 40～50℃。",
            "碱液降温至 40～45℃时，缓缓倒入油中，边倒边搅。",
            "持续搅拌至「trace」：在皂液上划过能留下不消失的痕迹，约 20～40 分钟。",
            "入模，盖好保温 24～48 小时，脱模切块，置于阴凉通风处晾 4～6 周成熟。",
            "用 pH 试纸测皂液，pH 降至 10 以下再使用。"
          ],
          "note": "氢氧化钠是强碱，会严重腐蚀皮肤黏膜，务必全套防护、远离儿童宠物；切记「碱倒入水」，反向会剧烈喷溅。成熟期不足的皂碱性太强，不可上脸。",
          "save": "纯橄榄油「卡斯蒂利亚皂」温和滋润，适合敏感肌；原料成本约 3 元/块。"
        },
        {
