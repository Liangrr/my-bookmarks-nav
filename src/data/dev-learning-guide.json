  "glossary": [
    { "term": "SPA", "plain": "单页应用：页面不刷新，由 JavaScript 切换视图与数据" },
    { "term": "SSR", "plain": "服务端渲染：HTML 在服务端生成后发给浏览器，利于首屏与 SEO" },
    { "term": "REST", "plain": "一种 API 设计风格：资源用名词 URL，操作用 HTTP 方法表达" },
    { "term": "GraphQL", "plain": "API 查询语言：客户端按需声明要哪些字段，单一端点返回" },
    { "term": "JWT", "plain": "JSON Web Token：服务端签发的身份令牌，客户端携带访问受保护接口" },
    { "term": "ORM", "plain": "对象关系映射：用代码对象操作数据库表，免写原生 SQL" },
    { "term": "CDN", "plain": "内容分发网络：把静态资源缓存到离用户近的节点，加速访问" },
    { "term": "CI/CD", "plain": "持续集成/持续部署：提交代码自动测试、构建并发布上线" },
    { "term": "Docker", "plain": "容器化工具：把应用与环境打包成镜像，随处一致运行" },
    { "term": "响应式设计", "plain": "一套界面自适应手机/平板/桌面，不用为每种屏幕单独做页面" }
  ]
}
