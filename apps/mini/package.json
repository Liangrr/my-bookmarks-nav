{
  "name": "asuria-mini",
  "version": "0.1.0",
  "private": true,
  "description": "ai-agent-asuria 小程序端（Taro 4 + React 18），复用 packages/shared-* 的真源数据与纯逻辑",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.0",
    "react-refresh": "^0.14.0",
    "typescript": "^5.6.0",
    "webpack": "^5.91.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.3.96": true,
    "@tarojs/binding@4.3.0": true,
    "@tarojs/cli@4.3.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
